{
  "expo": {
    "name": "היומן שלי",
    "slug": "my-life-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mylifediary.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "האפליקציה מקליטה את היומן היומי שלך."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14102B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mylifediary.app",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "האפליקציה מקליטה את היומן היומי שלך."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "אפשר לפתוח את היומן עם Face ID."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "האפליקציה מקשיבה כשאתה מכתיב את היומן.",
          "speechRecognitionPermission": "האפליקציה הופכת את הדיבור שלך לטקסט ביומן.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "כדי לצרף תמונה לרשומה ביומן, רק כשתבחר.",
          "cameraPermission": "כדי לצלם תמונה יומית, רק כשתבחר."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-iap",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Pet",
              "label": "החבר שלי",
              "description": "החבר שלך על מסך הבית",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-apple-authentication",
      "expo-status-bar"
    ],
    "backgroundColor": "#14102B"
  }
}
